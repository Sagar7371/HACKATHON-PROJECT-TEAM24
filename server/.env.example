PORT=5000
ADMIN_KEY=replace-with-a-long-random-admin-key
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap
CLIENT_URL=http://localhost:5173
# For multiple deployed frontend URLs, use CLIENT_URLS instead of CLIENT_URL.
# CLIENT_URLS=https://skillswap.example.com,https://www.skillswap.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=SkillSwap <no-reply@example.com>
# Prefer Brevo's HTTPS API on hosts that block outbound SMTP ports.
BREVO_API_KEY=your-brevo-api-key
